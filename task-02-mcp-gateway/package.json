{
  "name": "task-02-mcp-gateway",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Task 2 — MCP security gateway: HTTP/JSON-RPC reverse proxy with bearer auth and admin_* tool authorization.",
  "scripts": {
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "hygiene": "node scripts/check-logging-hygiene.mjs",
    "test": "node scripts/check-logging-hygiene.mjs && vitest run",
    "test:watch": "vitest",
    "test:live": "vitest run --config vitest.live.config.ts",
    "mock": "tsx mock/downstream.ts",
    "mint-token": "node scripts/mint-token.mjs",
    "demo": "node scripts/demo.mjs"
  },
  "dependencies": {
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
