{
  "name": "task-03-streaming-guardrail",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Task 3 — LLM gateway endpoint that redacts PII from streamed completions without buffering the response.",
  "scripts": {
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "hygiene": "node scripts/check-logging-hygiene.mjs",
    "test": "node scripts/check-logging-hygiene.mjs && vitest run",
    "test:watch": "vitest",
    "test:live": "vitest run --config vitest.live.config.ts",
    "bench": "node scripts/bench-ttft.mjs",
    "demo": "node scripts/demo.mjs",
    "demo:live": "node scripts/demo-live.mjs"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
