# =============================================================================
# ai-field-dev-assessment — environment template
#
# Copy to `.env` (git-ignored) and edit. Every task reads its own prefix, so a
# single file can drive all four services at once.
#
#   cp .env.example .env
#
# Tasks load this file themselves (no dotenv dependency): each entry point calls
# `loadDotEnv()` from its own `src/config.ts`, which reads `../.env` if present
# and never overrides variables that are already set in the process env.
# =============================================================================

# -----------------------------------------------------------------------------
# Task 1 — MCP server (stdio)
# -----------------------------------------------------------------------------
MCP_SERVER_NAME=customer-ops-mcp
MCP_SERVER_VERSION=1.0.0
# Optional JSON file whose customers seed the in-memory store (default: the built-in fixtures).
MCP_SEED_DATA_PATH=
MCP_LOG_LEVEL=info
# Optional: absolute path to a JSON file that replaces the built-in seed data.
# MCP_SEED_DATA_PATH=/absolute/path/to/customers.json

# -----------------------------------------------------------------------------
# Task 2 — MCP security gateway proxy
# -----------------------------------------------------------------------------
GATEWAY_PORT=8787
GATEWAY_DOWNSTREAM_URL=http://127.0.0.1:8788/mcp
# HMAC secret used to verify/sign gateway bearer tokens (see scripts/mint-token.mjs)
GATEWAY_TOKEN_SECRET=dev-secret-change-me
# Static dev tokens (role:token) accepted in addition to signed tokens
GATEWAY_DEV_TOKENS=admin:admin-dev-token,viewer:viewer-dev-token
GATEWAY_UPSTREAM_TIMEOUT_MS=10000
# Hardened mode: strip admin_* tools from tools/list for non-admin roles
GATEWAY_FILTER_TOOL_LIST=false
# Forward the caller's Authorization header downstream (default: strip it)
GATEWAY_FORWARD_CLIENT_AUTH=false
# Optional service credential injected when calling the downstream server
# GATEWAY_DOWNSTREAM_TOKEN=
# Optional credential injected when calling the downstream MCP server (default: none).
GATEWAY_DOWNSTREAM_TOKEN=
# Upper bound on an accepted JSON-RPC request body; larger bodies get 413.
GATEWAY_MAX_BODY_BYTES=1048576
# Optional file-driven policy rules (allow/deny globs, privileged prefixes).
GATEWAY_POLICY_FILE=
GATEWAY_LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Task 3 — LLM gateway streaming guardrail
# -----------------------------------------------------------------------------
GUARDRAIL_PORT=8790
# Any OpenAI-compatible server: llama.cpp (default), Ollama, vLLM, LM Studio...
GUARDRAIL_UPSTREAM_BASE_URL=http://127.0.0.1:8080/v1
GUARDRAIL_UPSTREAM_API_KEY=
GUARDRAIL_UPSTREAM_TIMEOUT_MS=120000
GUARDRAIL_REDACTION_REPLACEMENT=[REDACTED]
# Typed placeholders, e.g. [REDACTED:EMAIL] instead of [REDACTED]
GUARDRAIL_TYPED_PLACEHOLDERS=false
# Extra patterns as JSON: [{"name":"employee_id","pattern":"EMP-\\d{6}"}]
# GUARDRAIL_CUSTOM_PATTERNS=
GUARDRAIL_MAX_HOLDBACK_BYTES=512
# Extra PII patterns as JSON, e.g. [{"name":"employee_id","pattern":"EMP-[0-9]{6}"}]
GUARDRAIL_CUSTOM_PATTERNS=
GUARDRAIL_LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Task 4 — Rate-limiting & model fallback router
# -----------------------------------------------------------------------------
ROUTER_PORT=8791
ROUTER_DB_PATH=./data/router.db
ROUTER_WINDOW_MS=60000
ROUTER_LIMIT_TOKENS=50000
ROUTER_PRIMARY_NAME=primary
ROUTER_PRIMARY_BASE_URL=http://127.0.0.1:8080/v1
ROUTER_PRIMARY_MODEL=qwen3.8-turbo
ROUTER_PRIMARY_TIMEOUT_MS=3000
# Optional provider credentials. Never logged, never echoed to a client.
ROUTER_PRIMARY_API_KEY=
ROUTER_SECONDARY_NAME=secondary
ROUTER_SECONDARY_BASE_URL=http://127.0.0.1:8080/v1
ROUTER_SECONDARY_MODEL=qwen3.8-turbo
ROUTER_SECONDARY_TIMEOUT_MS=10000
ROUTER_SECONDARY_API_KEY=
ROUTER_MAX_ATTEMPTS=2
ROUTER_FAILOVER_ON=429,500,502,503,504,timeout,network
# sqlite driver: `better` (better-sqlite3, default) or `node` (node:sqlite, experimental built-in)
ROUTER_SQLITE_DRIVER=better

# Admission-time token estimate: chars/4 plus a per-message and per-tool overhead.
ROUTER_CHARS_PER_TOKEN=4
ROUTER_MESSAGE_OVERHEAD_TOKENS=4
ROUTER_TOOL_OVERHEAD_TOKENS=100

# Output budget reserved at admission (on top of the input estimate). A request with `max_tokens`
# reserves min(max_tokens, ROUTER_MAX_OUTPUT_RESERVE_TOKENS); one without reserves
# ROUTER_OUTPUT_RESERVE_TOKENS. Set both to 0 to reserve the input estimate only.
ROUTER_OUTPUT_RESERVE_TOKENS=1024
ROUTER_MAX_OUTPUT_RESERVE_TOKENS=16384

# Stall detector: how long a response BODY may stay silent before the attempt is killed. This is not
# the failover deadline (ROUTER_*_TIMEOUT_MS is time-to-first-response); a healthy stream may run for
# minutes. 0 disables it.
ROUTER_STREAM_IDLE_TIMEOUT_MS=30000

# How long the response BODY may take to *begin* after the headers arrived. A provider sends headers as
# soon as it accepts a request and then prompt-processes for seconds before the first token, so this gap
# is deliberately not charged to the stall watchdog above (which only starts on the first chunk).
# 0 disables it.
ROUTER_STREAM_FIRST_BYTE_TIMEOUT_MS=120000

# Ask the provider for `stream_options.include_usage` on streamed requests so streamed completions are
# reconciled against real usage. The frame is hidden again if the client did not ask for it.
ROUTER_INJECT_STREAM_USAGE=true

# Tenant allow-list (comma-separated). Unset = any bearer string is auto-provisioned as its own
# 50 000-token tenant, and the gateway warns about that at boot.
ROUTER_TENANT_KEYS=
ROUTER_LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Live (opt-in) suites and `npm run demo:live` — they call a real OpenAI-compatible server
# -----------------------------------------------------------------------------
# Set to 1 to enable `npm run test:live` in every task
RUN_LIVE_LLM=0
# One server for every live suite and live demo: llama.cpp, Ollama, vLLM, LM Studio, ...
# (Ollama, for example: http://127.0.0.1:11434/v1 with LIVE_OPENAI_MODEL=qwen3:8b).
# Rarely needed per-task overrides: GUARDRAIL_LIVE_BASE_URL / GUARDRAIL_LIVE_MODEL (Task 3),
# ROUTER_LIVE_BASE_URL / ROUTER_LIVE_MODEL (Task 4).
LIVE_OPENAI_BASE_URL=http://127.0.0.1:8080/v1
LIVE_OPENAI_MODEL=qwen3.8-turbo
# Token budget for Task 1's tool-calling loop (never below 512): qwen3-class models reason first.
LIVE_OPENAI_MAX_TOKENS=1024
